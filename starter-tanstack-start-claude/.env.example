# Your Anthropic API key, from https://console.anthropic.com/settings/keys. Read on the server only.
ANTHROPIC_API_KEY=

# Only to install Candor Pro or Premium items (see README). Not needed at runtime.
# CANDOR_LICENSE_KEY=

# Origins of other sites whose pages may start a run or answer a permission request here, comma-separated
# (e.g. https://admin.example.com). Leave it unset unless you need it: requests from other sites are refused.
# CANDOR_TRUSTED_ORIGINS=
