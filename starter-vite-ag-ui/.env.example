# Where your AG-UI agent listens (LangGraph, CrewAI, Mastra, Google ADK, Pydantic AI…). It receives a POST with a
# RunAgentInput and streams AG-UI events back as server-sent events.
# Leave it empty to use the scripted agent that runs in the browser, so the starter works with no backend.
# Vite puts every VITE_ variable in the page, so never put a secret here.
VITE_AGENT_URL=

# Only to install Candor Pro or Premium items (see README). Not needed at runtime.
# CANDOR_LICENSE_KEY=
