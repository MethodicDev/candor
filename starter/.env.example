# Your Anthropic API key, from https://console.anthropic.com/settings/keys. Server-side only.
ANTHROPIC_API_KEY=

# Signs AI SDK tool-approval requests so a browser can't approve a call the server never asked about.
# Any long random string, e.g. the output of: openssl rand -base64 32
CANDOR_APPROVAL_SECRET=

# Only to install Candor Pro or Premium items (see README). Not needed at runtime.
# CANDOR_LICENSE_KEY=
